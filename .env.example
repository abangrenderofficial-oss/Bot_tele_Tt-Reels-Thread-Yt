TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
SETUP_SECRET=
PUBLIC_BASE_URL=
BOT_OWNER_ID=
GITHUB_ACTIONS_TOKEN=

# Bot usage statistics (/totaluser)
STATS_SUPABASE_URL=
STATS_SUPABASE_KEY=
STATS_RPC_SECRET=

# Resolver / update safety
DOWNLOADER_TIMEOUT_MS=25000
UPDATE_STALE_AFTER_MS=120000
UPDATE_DEDUPE_TTL_MS=900000

# Telegram limits
TELEGRAM_UPLOAD_MAX_MB=50
TELEGRAM_UPLOAD_TIMEOUT_MS=55000

# Relay: timeout is for receiving upstream headers only; active streams are not cut off.
MEDIA_RELAY_HEADER_TIMEOUT_MS=30000

# Status HQ: isolated source/FFmpeg controls
STATUS_SOURCE_HEADER_TIMEOUT_MS=30000
STATUS_YTDLP_TIMEOUT_MS=120000
STATUS_YOUTUBE_TIMEOUT_MS=90000
STATUS_PROBE_TIMEOUT_MS=12000
STATUS_ENCODE_TIMEOUT_MS=260000
STATUS_FFMPEG_THREADS=2
STATUS_FILTER_THREADS=1
STATUS_HQ_TARGET_MB=45

# Status HQ image
STATUS_IMAGE_SOURCE_HEADER_TIMEOUT_MS=30000
STATUS_IMAGE_ENCODE_TIMEOUT_MS=90000

# Normal downloader compression: separate from Status HQ
SOCIAL_SOURCE_HEADER_TIMEOUT_MS=30000
SOCIAL_YTDLP_TIMEOUT_MS=120000
SOCIAL_COMPRESS_TIMEOUT_MS=70000
SOCIAL_COMPRESS_THREADS=2
SOCIAL_COMPRESS_PRESET=veryfast

# TikTok final rescue: separate from downloader + Status HQ
TIKTOK_RESCUE_DOWNLOAD_TIMEOUT_MS=45000
TIKTOK_RESCUE_PROBE_TIMEOUT_MS=12000
TIKTOK_RESCUE_COMPRESS_TIMEOUT_MS=120000
TIKTOK_RESCUE_COMPRESS_THREADS=4
TIKTOK_RESCUE_COMPRESS_PRESET=veryfast

# Gallery heavy jobs -> GitHub Actions worker
HEAVY_VIDEO_THRESHOLD_MB=18
HEAVY_VIDEO_MAX_MB=150
GITHUB_WORKER_OWNER=abangrenderofficial-oss
GITHUB_WORKER_REPO=mdab-129
GITHUB_WORKER_WORKFLOW=heavy-status-hq.yml
GITHUB_WORKER_REF=main
GITHUB_WORKER_DISPATCH_TIMEOUT_MS=12000
